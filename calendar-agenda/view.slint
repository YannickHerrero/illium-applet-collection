import { ScrollView } from "std-widgets.slint";

struct Cell { day: int, date: string, current: bool, today: bool, selected: bool, count: int }
struct Calendar { key: string, name: string, connection: string, visible: bool, color: int }
struct Event { key: string, title: string, location: string, time: string, calendar: string, color: int, ongoing: bool, join: bool }
struct Status { name: string, message: string, stale: bool }
struct Data { month: string, day: string, weeks: [[Cell]], calendars: [Calendar], events: [Event], statuses: [Status], more: int, empty: bool }

component AgendaButton inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <color> fill;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 32px;
    height: 30px;
    background: touch.has-hover && root.enabled ? root.fill : transparent;
    border-width: 1px;
    border-color: root.fill;
    accessible-role: button;
    accessible-label: root.label;
    Text { text: root.label; color: root.ink; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component View inherits Window {
    no-frame: true;
    in property <length> popup-width: 480px;
    in property <length> popup-height: 780px;
    width: popup-width;
    height: popup-height;
    in property <color> bg: #1e1e2e;
    in property <color> surface: #313244;
    in property <color> overlay: #45475a;
    in property <color> fg: #cdd6f4;
    in property <color> muted: #a6adc8;
    in property <color> accent: #cba6f7;
    in property <bool> busy;
    in property <bool> open;
    in property <string> provider-error;
    in property <Data> data;
    callback action(string);
    private property <bool> sources-expanded: true;
    private property <bool> was-open: false;
    // Opening requests the provider; its cache suppresses unnecessary COM reads.
    changed open => {
        if root.open && !root.was-open { root.action(""); }
        root.was-open = root.open;
    }
    pure function source-color(index: int) -> color {
        if index == 0 { return root.accent; }
        if index == 1 { return root.accent.mix(root.fg, 0.4); }
        if index == 2 { return root.fg; }
        if index == 3 { return root.accent.mix(root.muted, 0.6); }
        if index == 4 { return root.muted; }
        return root.accent.mix(root.fg, 0.7);
    }
    background: root.bg;
    Rectangle {
        border-width: 1px;
        border-color: root.overlay;
        VerticalLayout {
            padding: 18px;
            spacing: 10px;
            HorizontalLayout {
                height: 32px;
                Text { text: "AGENDA"; color: root.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                Text { text: root.busy ? "Refreshing…" : "Read only"; color: root.muted; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                AgendaButton { label: "Refresh"; width: 72px; ink: root.fg; fill: root.overlay; enabled: !root.busy; clicked => { root.action("refresh"); } }
            }
            HorizontalLayout {
                height: 32px;
                AgendaButton { label: "‹"; width: 32px; ink: root.fg; fill: root.overlay; enabled: !root.busy; clicked => { root.action("month -1"); } }
                Text { text: root.data.month; color: root.fg; font-size: 21px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                AgendaButton { label: "›"; width: 32px; ink: root.fg; fill: root.overlay; enabled: !root.busy; clicked => { root.action("month 1"); } }
                AgendaButton { label: "Today"; width: 54px; ink: root.accent; fill: root.overlay; enabled: !root.busy; clicked => { root.action("today"); } }
            }
            HorizontalLayout {
                height: 18px;
                for name in ["MO", "TU", "WE", "TH", "FR", "SA", "SU"]: Text { text: name; color: root.muted; font-size: 10px; horizontal-alignment: center; }
            }
            VerticalLayout {
                height: 216px;
                spacing: 2px;
                for week in root.data.weeks: HorizontalLayout {
                    spacing: 2px;
                    for cell in week: Rectangle {
                        background: cell.selected ? root.surface : (day-touch.has-hover ? root.overlay : transparent);
                        border-width: cell.today || cell.selected ? 1px : 0px;
                        border-color: cell.today ? root.accent : root.overlay;
                        accessible-role: button;
                        accessible-label: cell.date;
                        Text { y: 3px; height: 22px; text: "\{cell.day}"; color: cell.current ? root.fg : root.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        if cell.count > 0: Rectangle { width: 4px; height: 4px; border-radius: 2px; x: (parent.width - self.width) / 2; y: parent.height - 7px; background: root.accent; }
                        day-touch := TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.action("day " + cell.date); } }
                    }
                }
            }
            AgendaButton { label: root.sources-expanded ? "Calendars ▾" : "Calendars ▸"; ink: root.muted; fill: root.overlay; clicked => { root.sources-expanded = !root.sources-expanded; } }
            if root.sources-expanded: ScrollView {
                height: 88px;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 3px;
                    for calendar in root.data.calendars: Rectangle {
                        height: 25px;
                        accessible-role: checkbox;
                        accessible-label: calendar.connection + ": " + calendar.name;
                        accessible-checked: calendar.visible;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 18px; height: 18px;
                                border-width: 1px; border-color: root.source-color(calendar.color);
                                background: calendar.visible ? root.source-color(calendar.color) : transparent;
                                Text { text: calendar.visible ? "✓" : ""; color: root.bg; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Text { text: calendar.connection + " / " + calendar.name; color: calendar.visible ? root.fg : root.muted; overflow: elide; font-size: 12px; }
                        }
                        TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.action("toggle " + calendar.key); } }
                    }
                    if root.data.calendars.length == 0: Text { text: "No calendars available"; color: root.muted; font-size: 12px; }
                }
            }
            Rectangle { height: 1px; background: root.overlay; }
            Text { text: root.data.day; color: root.fg; font-size: 13px; font-weight: 600; }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 7px;
                    for event in root.data.events: Rectangle {
                        height: event.join ? 112px : 78px;
                        background: root.surface;
                        Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: root.source-color(event.color); }
                        VerticalLayout {
                            padding: 9px; padding-left: 12px; spacing: 4px;
                            Text { text: event.time + (event.ongoing ? " · NOW" : "") + " · " + event.calendar; color: event.ongoing ? root.accent : root.muted; font-size: 10px; overflow: elide; }
                            Text { text: event.title == "" ? "(Untitled event)" : event.title; color: root.fg; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: event.location; color: root.muted; font-size: 11px; overflow: elide; }
                            if event.join: HorizontalLayout {
                                AgendaButton { label: "Join meeting"; width: 104px; ink: root.accent; fill: root.overlay; enabled: !root.busy; clicked => { root.action("join " + event.key); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    if root.data.empty: Text { text: "No events in visible calendars"; color: root.muted; font-size: 12px; }
                    if root.data.more > 0: Text { text: "\{root.data.more} more events — open the source calendar to see all"; color: root.muted; font-size: 11px; wrap: word-wrap; }
                }
            }
            ScrollView {
                height: 48px;
                viewport-width: self.width;
                VerticalLayout {
                    spacing: 3px;
                    for status in root.data.statuses: Text { text: status.name + ": " + (status.stale ? "[stale] " : "") + status.message; color: status.stale ? root.accent : root.muted; font-size: 10px; wrap: word-wrap; }
                    if root.provider-error != "": Text { text: "Refresh failed. Check the applet configuration."; color: root.accent; font-size: 11px; }
                }
            }
        }
    }
}
