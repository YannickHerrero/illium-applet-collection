import { ScrollView } from "std-widgets.slint";

struct Cell { day: int, date: string, current: bool, today: bool, selected: bool, count: int, markers: [int] }
struct Calendar { key: string, name: string, label: string, connection: string, visible: bool, color: int }
struct Event { key: string, title: string, location: string, time: string, calendar: string, color: int, ongoing: bool, join: bool }
struct Day { date: string, label: string, count: int, events: [Event], more: int }
struct Data { today-header: string, current-year: int, year-progress: float, notice: string, month: string, day-index: int, today-index: int, days: [Day], all-visible: bool, week-numbers: [int], weeks: [[Cell]], calendars: [Calendar] }

component AgendaButton inherits Rectangle {
    in property <string> label;
    in property <color> ink;
    in property <color> fill;
    in property <bool> enabled: true;
    in property <bool> outlined: false;
    in property <bool> icon-only: false;
    in property <image> icon;
    callback clicked();
    height: 20px;
    background: touch.has-hover && root.enabled ? root.fill : transparent;
    border-width: root.outlined ? 1px : 0px;
    border-color: root.fill;
    accessible-role: button;
    accessible-label: root.label;
    if !root.icon-only: Text { text: root.label; color: root.ink; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
    if root.icon-only: Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 12px; height: 12px; source: root.icon; colorize: root.ink; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component View inherits Window {
    no-frame: true;
    in property <length> popup-width: 440px;
    in property <length> popup-height: 820px;
    width: popup-width;
    // Stable geometry: day selection and refresh never move the popup or controls.
    height: root.popup-height;
    // Installed with the user's Scoop font pack; Windows falls back if unavailable.
    default-font-family: "JetBrainsMono NFM";
    default-font-size: 10px;
    in property <color> bg: #1e1e2e;
    in property <color> surface: #313244;
    in property <color> overlay: #45475a;
    in property <color> fg: #cdd6f4;
    in property <color> muted: #a6adc8;
    in property <color> accent: #cba6f7;
    in property <bool> busy;
    in property <bool> open;
    in property <string> provider-error;
    in property <Data> data;
    callback action(string);
    callback dismissed();
    private property <int> selected-index: root.data.day-index;
    private property <string> loaded-month: "";
    private property <bool> month-pending: false;
    private property <bool> opening-pending: false;
    private property <Day> selected: root.data.days[root.selected-index];
    changed data => {
        if root.opening-pending || root.loaded-month != root.data.month {
            root.selected-index = root.opening-pending && root.data.today-index >= 0 ? root.data.today-index : root.data.day-index;
            root.loaded-month = root.data.month;
            root.month-pending = false;
            if root.data.today-index >= 0 && root.data.day-index == root.data.today-index {
                root.opening-pending = false;
            }
        }
    }
    changed provider-error => { if root.provider-error != "" { root.month-pending = false; root.opening-pending = false; } }
    changed open => {
        if root.open {
            // Cached today is immediate; the provider recomputes the local date,
            // including after midnight or when browsing a different month.
            if root.data.today-index >= 0 { root.selected-index = root.data.today-index; }
            root.opening-pending = true;
            events-scroll.viewport-y = 0px;
            root.action("today");
        }
    }
    // Persist once after interaction, never on the click-to-display path.
    dismissed => { if !root.opening-pending && !root.month-pending && root.loaded-month == root.data.month && root.selected.date != "" { root.action("day " + root.selected.date); } }
    pure function source-color(index: int) -> color {
        if index == 0 { return root.accent; }
        if index == 1 { return root.accent.mix(root.fg, 0.4); }
        if index == 2 { return root.fg; }
        if index == 3 { return root.accent.mix(root.muted, 0.6); }
        if index == 4 { return root.muted; }
        return root.accent.mix(root.fg, 0.7);
    }
    background: root.bg;
    Rectangle {
        border-width: 1px;
        border-color: root.accent.mix(root.overlay, 0.6);
        content := VerticalLayout {
            padding-left: 50px; padding-right: 50px;
            padding-top: 20px; padding-bottom: 16px;
            spacing: 6px;
            HorizontalLayout {
                height: 52px;
                spacing: 14px;
                Image { width: 30px; height: 52px; source: @image-url("icon.svg"); image-fit: contain; colorize: root.fg; }
                Text { text: root.data.today-header == "" ? "Calendar" : root.data.today-header; color: root.fg; font-size: 38px; font-weight: 600; vertical-alignment: center; overflow: elide; }
            }
            HorizontalLayout {
                height: 16px;
                spacing: 10px;
                Text { width: 26px; text: root.data.current-year > 0 ? "\{root.data.current-year}" : ""; color: root.muted; font-size: 8px; vertical-alignment: center; }
                Rectangle {
                    Rectangle {
                        x: 0px; y: (parent.height - self.height) / 2;
                        height: 4px; width: parent.width;
                        background: root.surface;
                        Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp(root.data.year-progress / 100, 0, 1); background: root.fg; }
                    }
                }
                Text { width: 26px; text: root.data.current-year > 0 ? "\{floor(root.data.year-progress)}%" : ""; color: root.muted; font-size: 8px; horizontal-alignment: right; vertical-alignment: center; }
            }
            Rectangle { height: 8px; }
            if root.provider-error != "" || root.data.notice != "": Text {
                text: root.provider-error != "" ? "Refresh failed. Check the applet configuration." : root.data.notice;
                color: root.accent; font-size: 9px; overflow: elide;
            }
            HorizontalLayout {
                height: 12px;
                spacing: 2px;
                Text { width: 26px; text: "W"; color: root.muted; font-size: 8px; horizontal-alignment: center; }
                for name in ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]: Text { text: name; color: root.muted; font-size: 8px; horizontal-alignment: center; }
            }
            VerticalLayout {
                height: 174px;
                spacing: 2px;
                for week[week-index] in root.data.weeks: HorizontalLayout {
                    spacing: 2px;
                    Text { width: 26px; text: "\{root.data.week-numbers[week-index]}"; color: root.muted; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                    for cell[cell-index] in week: Rectangle {
                        background: day-touch.has-hover ? root.surface : transparent;
                        border-width: cell.today || cell.date == root.selected.date ? 1px : 0px;
                        border-color: cell.date == root.selected.date ? root.fg.mix(root.bg, 0.35) : root.overlay;
                        accessible-role: button;
                        accessible-label: cell.date;
                        Text { y: 1px; height: 17px; text: "\{cell.day}"; color: cell.current ? root.fg : root.muted.mix(root.bg, 0.5); font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                        HorizontalLayout {
                            y: parent.height - 7px; x: (parent.width - self.width) / 2;
                            width: cell.markers.length * 5px; height: 3px; spacing: 2px;
                            for marker in cell.markers: Rectangle { width: 3px; height: 3px; border-radius: 1px; background: root.source-color(marker); }
                        }
                        day-touch := TouchArea { mouse-cursor: pointer; clicked => { root.opening-pending = false; root.selected-index = week-index * 7 + cell-index; } }
                    }
                }
            }
            HorizontalLayout {
                height: 24px;
                AgendaButton { label: "‹"; accessible-label: "Previous month"; width: 18px; ink: root.muted; fill: root.surface; enabled: !root.busy; clicked => { root.month-pending = true; root.action("month -1"); } }
                Text { text: root.data.month; color: root.muted; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                AgendaButton { label: "›"; accessible-label: "Next month"; width: 18px; ink: root.muted; fill: root.surface; enabled: !root.busy; clicked => { root.month-pending = true; root.action("month 1"); } }
            }
            Rectangle { height: 1px; background: root.overlay; }
            HorizontalLayout {
                height: 22px;
                spacing: 6px;
                Text { text: root.data.days.length == 0 ? "Loading calendar…" : root.selected.label; color: root.fg; font-size: 9px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 0; }
                Rectangle {
                    width: 20px; height: 14px; background: root.surface;
                    Text { text: root.data.days.length == 0 ? "…" : "\{root.selected.count}"; color: root.muted; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                AgendaButton { label: "Today"; width: 36px; ink: root.muted; fill: root.surface; enabled: root.data.today-index >= 0 || !root.busy; clicked => { if root.data.today-index >= 0 { root.selected-index = root.data.today-index; } else { root.month-pending = true; root.action("today"); } } }
                AgendaButton { label: "Refresh"; icon-only: true; icon: @image-url("refresh.svg"); width: 20px; ink: root.busy ? root.overlay : root.muted; fill: root.surface; enabled: !root.busy; clicked => { root.action("refresh"); } }
            }
            // Horizontal, scrollable checkbox chips replace the tall source panel.
            Flickable {
                height: 24px;
                viewport-height: self.height;
                viewport-width: chips.preferred-width;
                interactive: true;
                chips := HorizontalLayout {
                    width: self.preferred-width; height: 20px; spacing: 4px;
                    AgendaButton { label: "All"; width: 28px; height: 18px; outlined: true; ink: root.data.all-visible ? root.fg : root.muted; fill: root.data.all-visible ? root.muted : root.overlay; enabled: !root.busy; clicked => { root.action("show-all"); } }
                    for calendar in root.data.calendars: Rectangle {
                        width: min(142px, chip-label.preferred-width + 22px); height: 18px;
                        border-width: 1px;
                        border-color: calendar.visible ? root.muted : root.overlay;
                        background: chip-touch.has-hover ? root.surface : transparent;
                        accessible-role: checkbox;
                        accessible-label: calendar.connection + ": " + calendar.name;
                        accessible-checked: calendar.visible;
                        Rectangle { x: 5px; y: 6px; width: 5px; height: 5px; background: calendar.visible ? root.source-color(calendar.color) : transparent; border-width: 1px; border-color: root.source-color(calendar.color); }
                        chip-label := Text { x: 14px; y: 0px; width: parent.width - 19px; height: parent.height; text: calendar.label; color: calendar.visible ? root.fg : root.muted; font-size: 8px; vertical-alignment: center; overflow: elide; }
                        chip-touch := TouchArea { enabled: !root.busy; mouse-cursor: pointer; clicked => { root.action("toggle " + calendar.key); } }
                    }
                }
            }
            events-scroll := ScrollView {
                min-height: 20px;
                preferred-height: max(20px, event-list.preferred-height);
                vertical-stretch: 1;
                viewport-width: self.width;
                horizontal-scrollbar-policy: always-off;
                event-list := VerticalLayout {
                    spacing: 4px;
                    if root.data.days.length == 0: VerticalLayout {
                        spacing: 10px;
                        for ratio in [0.7, 0.9, 0.6]: Rectangle {
                            height: 14px;
                            Rectangle { width: parent.width * ratio; height: 100%; background: root.overlay; border-radius: 3px; }
                        }
                    }
                    for event in root.selected.events: Rectangle {
                        height: 32px + (event.location != "" ? 12px : 0px) + (event.join ? 20px : 0px);
                        background: root.surface;
                        Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: root.source-color(event.color); }
                        Text { x: 8px; y: 4px; width: parent.width - 16px; height: 9px; text: event.time + " · " + event.calendar + (event.ongoing ? " · NOW" : ""); color: root.muted; font-size: 7.5px; overflow: elide; }
                        Text { x: 8px; y: 15px; width: parent.width - 16px; height: 13px; text: event.title == "" ? "(Untitled event)" : event.title; color: root.fg; font-size: 10px; font-weight: 500; overflow: elide; }
                        Text { visible: event.location != ""; x: 8px; y: 28px; width: parent.width - 16px; height: 12px; text: "· " + event.location; color: root.muted; font-size: 8px; vertical-alignment: center; overflow: elide; }
                        AgendaButton {
                            visible: event.join;
                            x: 8px; y: 28px + (event.location != "" ? 12px : 0px);
                            label: "Join meeting"; width: 82px; height: 16px; outlined: true;
                            ink: root.fg; fill: root.muted; enabled: !root.busy;
                            clicked => { root.action("join " + event.key); }
                        }
                    }
                    if root.data.days.length > 0 && root.selected.count == 0: Text { text: "No events in visible calendars"; color: root.muted; font-size: 9px; }
                    if root.selected.more > 0: Text { text: "\{root.selected.more} more events — open the source calendar to see all"; color: root.muted; font-size: 9px; wrap: word-wrap; }
                }
            }
        }
    }
}
